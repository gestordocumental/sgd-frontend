# ── Desarrollo local ────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Las variables VITE_* se exponen al bundle del cliente (accesibles via import.meta.env).
# No guardes secretos de producción en variables VITE_* — son públicas en el bundle.

# URL base del API Gateway (Kong).
# En desarrollo local Kong corre en el puerto 8000 por defecto.
# El servidor de Vite proxea /api/* a esta URL (ver vite.config.ts).
VITE_API_URL=http://localhost:8000/api/v1

# Activar interceptores MSW para desarrollo sin backend (true | false).
# Con true, las peticiones HTTP son interceptadas por los handlers en src/mocks/.
# Con false, las peticiones van al backend real (requiere VITE_API_URL activo).
# En producción siempre debe ser false.
VITE_USE_MOCKS=true

# DSN de Sentry para error tracking en producción (opcional).
# Déjalo vacío en desarrollo — Sentry solo envía eventos cuando está configurado
# y el build es de producción (import.meta.env.PROD === true).
# Obtén el DSN en: Settings → Projects → <proyecto> → Client Keys en Sentry.
VITE_SENTRY_DSN=

# ── Variables de despliegue (NO van en este archivo) ────────────────────────
# Las siguientes variables se configuran en el dashboard de la plataforma
# de despliegue (Vercel / Railway) y no deben estar en .env:
#
#   RAILWAY_API_URL   → URL pública del API Gateway en Railway.
#                       Usada por vercel.json para el proxy server-side /api/*.
#                       Ejemplo: https://api-gateway.railway.app
